# замените поля в фигурных скобках на соответствующие вашему PostgreSQL пользователю.
BOOK_DATABASE_URL="postgresql://{user}:{password}@postgres:5432/{db-name}"

# придумайте свой приватный ключ, в идеале это строка от 10 символов с буквами в разном регистре, цифрами и символами.
PRIVATE_KEY="your_private_key" 

# время жизни вашего jwt токена.
EXPIRES_IN="2h"

REDIS_PORT=6379
REDIS_HOST="redis"
REDIS_TTL=180